theorem f29K5_irreducible : Irreducible f29K5 := by
  have hm : f29K5.Monic := by unfold f29K5; monicity <;> norm_num
  have hd : f29K5.natDegree = 29 := by
    have hp : ((X:P17)^29).natDegree = 29 := Polynomial.natDegree_X_pow 29
    have hs : (f29K5 - (X:P17)^29).natDegree ≤ 27 := by
      have hrest : f29K5 - (X:P17)^29 =
          X^27 + X^24 + X^21 + X^19 + X^18 + X^17 + X^14 + X^13 + X^12 + X^6 + X^3 + X^2 + X + 1 := by
        unfold f29K5
        ring_nf
      rw [hrest, Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      have hN0 : N ≠ 0 := by omega
      have hN1 : N ≠ 1 := by omega
      have hN2 : N ≠ 2 := by omega
      have hN3 : N ≠ 3 := by omega
      have hN6 : N ≠ 6 := by omega
      have hN12 : N ≠ 12 := by omega
      have hN13 : N ≠ 13 := by omega
      have hN14 : N ≠ 14 := by omega
      have hN17 : N ≠ 17 := by omega
      have hN18 : N ≠ 18 := by omega
      have hN19 : N ≠ 19 := by omega
      have hN21 : N ≠ 21 := by omega
      have hN24 : N ≠ 24 := by omega
      have hN27 : N ≠ 27 := by omega
      simp [Polynomial.coeff_X_pow, Polynomial.coeff_one, hN0, hN1, hN2,
        hN3, hN6, hN12, hN13, hN14, hN17, hN18, hN19, hN21, hN24, hN27,
        Polynomial.coeff_X, hN1.symm]
    have hlt : (f29K5 - (X:P17)^29).natDegree < ((X:P17)^29).natDegree := by rw [hp]; omega
    have he : f29K5 = (X:P17)^29 + (f29K5 - (X:P17)^29) := by ring
    rw [he, Polynomial.natDegree_add_eq_left_of_natDegree_lt hlt, hp]
  have h0 : f29K5 ≠ 0 := by intro h; rw [h] at hd; norm_num at hd
  have hne : f29K5 ≠ 1 := by intro h; have hh := congrArg Polynomial.natDegree h; rw [hd] at hh; norm_num at hh
  rw [Polynomial.Monic.irreducible_iff_degree_lt hm hne]
  intro q hqdeg hqf
  by_contra hqnot
  obtain ⟨g, hgm, hgi, hgq⟩ := Polynomial.exists_monic_irreducible_factor q hqnot
  have hq0 : q ≠ 0 := by intro h; subst q; simp at hqf; exact h0 hqf
  have hqN : q.natDegree ≤ 14 := by
    rw [Polynomial.degree_eq_natDegree hq0] at hqdeg
    rw [hd] at hqdeg
    norm_num at hqdeg
    exact_mod_cast hqdeg
  have hgN : g.natDegree ≤ 14 := (Polynomial.natDegree_le_of_dvd hgq hq0).trans hqN
  have hgf9 : g ∣ f29K5 := dvd_trans hgq hqf
  have hgf : g ∣ frobPoly 29 - X := dvd_trans hgf9 f29K5_dvd_frobPoly_sub
  have hdiv : g.natDegree ∣ 29 := (irreducible_degree_dvd_frobPoly g hgi 29).2 hgf
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 29)).mp hdiv with hone | h29
  · have hdiv1 : g.natDegree ∣ 1 := by simpa [hone]
    have hdiv1' : g ∣ frobPoly 1 - X := (irreducible_degree_dvd_frobPoly g hgi 1).1 hdiv1
    have hg2 : g ∣ (X:P17)^2-X := by
      simpa [frobPoly_eq_pow] using hdiv1'
    have hneg : -(X:P17) = X := by
      have hx : (X:P17)+X=0 := by have ht := congrArg (fun z:P17 => z*X) c2_17; simpa [two_mul] using ht
      exact neg_eq_of_add_eq_zero_left hx
    have hg2plus : g ∣ (X:P17)^2+X := by simpa [sub_eq_add_neg, hneg] using hg2
    have hone' : g ∣ (1:P17) := by
      rw [← f29K5_bezout]
      exact dvd_add (dvd_mul_of_dvd_right hgf9 _) (dvd_mul_of_dvd_right hg2plus _)
    exact hgi.not_isUnit (isUnit_of_dvd_one hone')
  · omega
