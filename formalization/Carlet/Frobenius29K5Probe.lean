lemma f29K5_square_step {a r s q : P17} (h : f29K5 ∣ a+r)
    (hr : r^2+s=f29K5*q) : f29K5 ∣ a^2+s := by
  have h1 : f29K5 ∣ (a+r)^2 := dvd_pow h (by norm_num)
  have h2 : f29K5 ∣ r^2+s := ⟨q, hr⟩
  have h3 : f29K5 ∣ (a+r)^2+(r^2+s) := dvd_add h1 h2
  have heq : (a+r)^2+(r^2+s)=a^2+s := by ring_nf <;> simp [c2_17, c3_17, c4_17]
  rw [heq] at h3
  exact h3
lemma f29K5_frob_step (m : Nat) {r s q : P17}
    (h : f29K5 ∣ frobPoly m + r) (hr : r^2+s=f29K5*q) :
    f29K5 ∣ frobPoly (m+1) + s := by
  have hs := f29K5_square_step h hr
  have hp : (frobPoly m)^2 = frobPoly (m+1) := (frobPoly_succ m).symm
  exact (congrArg (fun z : P17 => f29K5 ∣ z+s) hp).mp hs
